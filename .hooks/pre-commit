#!/bin/bash
# Étape 24 — CI locale : les évals DOIVENT passer avant chaque commit.
# Installé via : git config core.hooksPath .hooks
#
# Contournements (volontairement visibles — matière de l'étape 25, « la chute ») :
#   git commit --no-verify        → saute TOUS les hooks
#   SAUTER_EVALS=1 git commit …   → saute uniquement les évals
set -u

ROUGE='\033[31m'; VERT='\033[32m'; JAUNE='\033[33m'; FIN='\033[0m'
RACINE="$(git rev-parse --show-toplevel)"

if [ "${SAUTER_EVALS:-0}" = "1" ]; then
  printf "${JAUNE}⚠ Évals SAUTÉES (SAUTER_EVALS=1) — le commit part sans filet.${FIN}\n"
  exit 0
fi

# Ne rejouer les évals que si le commit touche ce qui influence le comportement
# de l'assistant (code, prompts, serveurs MCP, corpus, évals elles-mêmes)
if ! git diff --cached --name-only | grep -qE '^(src/|mcp/.*\.js|corpus/|evals/|pom\.xml)'; then
  printf "${VERT}✓ Commit sans impact sur l'assistant — évals non rejouées.${FIN}\n"
  exit 0
fi

printf "Rejeu du jeu d'évals avant commit (annuler : Ctrl-C ; sauter : --no-verify)…\n"

if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
  printf "${ROUGE}✗ ANTHROPIC_API_KEY absente de l'environnement — impossible de rejouer les évals.${FIN}\n"
  printf "  Exportez la clé puis recommitez, ou assumez le saut : SAUTER_EVALS=1 git commit …\n"
  exit 1
fi
if ! curl -s -o /dev/null -m 5 http://localhost:8080/; then
  printf "${ROUGE}✗ L'application ne répond pas sur :8080 — démarrez-la avant de committer.${FIN}\n"
  printf "  (ou assumez le saut : SAUTER_EVALS=1 git commit …)\n"
  exit 1
fi

if python3 "$RACINE/scripts/rejouer_evals.py" --reset; then
  printf "${VERT}✓ Évals au vert — commit autorisé.${FIN}\n"
  exit 0
else
  printf "${ROUGE}✗ ÉVALS EN ÉCHEC — commit BLOQUÉ.${FIN}\n"
  printf "  Le comportement de l'assistant a régressé : corrigez avant de committer.\n"
  printf "  (passage en force assumé et tracé : SAUTER_EVALS=1 git commit …)\n"
  exit 1
fi
